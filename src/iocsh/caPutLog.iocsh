# ---
#- ###               CAPUTLOG iocsh                 ###
#- ####################################################
#- >> Mandatory
#- IOCNAME              - IOC NAME
#- CAPUTLOG_INET        - EPICS_IOC_LOG_INET
#- >> Optional
#- CAPUTLOG_INET_PORT   - EPICS_IOC_LOG_PORT, Default : 8002
#- CAPUTLOG_OPTION      - caPutLog options, Default : 0
#-                       -1  no logging (disable)
#-                       0   log only on value change
#-                       1   log all puts
#-                       2   log all puts no filtering on same PV
#- ####################################################

#- require has afterInit function
afterInit("caPutJsonLogInit $(CAPUTLOG_INET):$(CAPUTLOG_INET_PORT=8002) $(CAPUTLOG_OPTION=1)")
afterInit("caPutJsonLogAddMetadata iocName $(IOCNAME)")
# ...
